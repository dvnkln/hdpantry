# Copy to .env and fill in. Everything else is configured in the app.

# Random string (min. 32 chars) used to sign sessions.
# How to: openssl rand -hex 32
SECRET=

# Timezone, e.g. Europe/Berlin
TZ=Europe/Berlin

# The exact address(es) you open the app with (protocol + host + port, no trailing slash). Login fails if none matches.
# Several addresses: comma-separated, the first one is the main address.
# Example: ORIGIN=http://192.168.1.50:3000,https://pantry.example.com
ORIGIN=http://localhost:3000
